# Shared secret clients send as a Bearer token, at least 16 characters
OCR_API_KEY=
# Hosts job URLs may point to, comma-separated; "*." matches subdomains
ALLOWED_SOURCE_HOSTS=files.example.com,*.cdn.example.net
# Treat output without any digit as unreadable (for documents that always have numbers)
REQUIRE_DIGITS=false
TEXT_WORKERS=2
OCR_WORKERS=1
PREWARM_VLM=false
